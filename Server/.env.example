# Copy to .env. Process environment takes precedence. Restart after changes.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CLIENT_URL=http://localhost:4200

# Keep database credentials here on the server, never in client/.env.
# Supports mongodb:// and mongodb+srv:// (including Atlas).
MONGODB_URI=mongodb://localhost:27017/Parley
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000

# Applies to new sessions only; permitted range: 1–168 hours.
SESSION_TTL_HOURS=24
